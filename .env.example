# AI Studio runtime environment variables (server/platform-managed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Frontend public configuration (safe for browser bundle; NEVER put service_role keys here)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_EVIDENCE_BUCKET="waste-evidence"
# Comma-separated OAuth providers explicitly enabled in Supabase Auth (e.g. "google,github,azure")
VITE_SUPABASE_OAUTH_PROVIDERS=""

# Separately deployable Python FastAPI + ONNX Runtime inference service URL
# Example local: http://localhost:8000
VITE_API_BASE_URL=""
VITE_INFERENCE_API_URL=""

# Optional verified operator, legal, and contact configuration (leave blank if unconfigured)
VITE_LEGAL_ENTITY_NAME=""
VITE_GOVERNING_JURISDICTION=""
VITE_CONTACT_EMAIL=""
VITE_PRIVACY_EMAIL=""
VITE_LEGAL_EMAIL=""
VITE_GRIEVANCE_OFFICER_NAME=""
VITE_GRIEVANCE_OFFICER_EMAIL=""
# Dedicated backend contact endpoint URL (POST JSON); leave blank until implemented
VITE_CONTACT_ENDPOINT_URL=""

