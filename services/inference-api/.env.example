# Separately deployable FastAPI + ONNX Runtime service environment template
# Keep SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET strictly server-side.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Model & exported Colab artefacts (all required for /ready)
MODEL_PATH=
CLASS_NAMES_PATH=
PREPROCESSING_CONFIG_PATH=
CONFIDENCE_CONFIG_PATH=
MODEL_VERSION=

# Server-side Supabase persistence, storage & JWT verification
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=waste-evidence

# Image validation limits
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192

# Configurable API rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional default jurisdiction filter
DEFAULT_JURISDICTION_CODE=
